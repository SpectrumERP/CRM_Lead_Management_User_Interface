{
  "name": "force-intellect-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "oxfmt",
    "dev:remotes": "node scripts/dev-all.mjs --remotes-only",
    "dev:task": "node scripts/dev-all.mjs --remotes-only",
    "build:remotes": "node scripts/build-remotes.mjs",
    "build:task": "node scripts/build-remotes.mjs",
    "build:all": "npm run build && npm run build:remotes",
    "setup:task": "npm --prefix task-management install",
    "dev:crm": "vite",
    "dev:spectrum": "vite --mode spectrum",
    "build:spectrum": "vite build --mode spectrum"
  },
  "dependencies": {
    "@techstark/opencv-js": "^4.12.0-release.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-image-crop": "^11.1.2",
    "react-router-dom": "^7.18.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.1"
  }
}
